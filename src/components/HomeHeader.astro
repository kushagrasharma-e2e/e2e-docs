---
// Standalone header for the homepage — mirrors the Starlight header look
// Uses the same starlight-theme localStorage key so theme is shared across all pages

import { docsPath } from '../utils/docsPath';
---

{/* Prevent FOUC: set data-theme before first paint, same logic as Starlight's ThemeProvider */}
<script is:inline>
  (function () {
    var stored = typeof localStorage !== 'undefined' && localStorage.getItem('starlight-theme');
    var preferred = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    document.documentElement.dataset.theme = stored === 'light' || stored === 'dark' ? stored : preferred;
  })();
</script>

<header class="home-header">
  <div class="home-header__inner">
    <a class="home-header__title" href={docsPath('/')}>E2E Cloud Docs</a>

    <nav class="home-header__products" aria-label="Products">
      <a href={docsPath('/myaccount/')} class="home-header__product-link">MyAccount</a>
      <a href={docsPath('/tir/')} class="home-header__product-link">TIR</a>
    </nav>

    <button
      class="home-header__theme-toggle"
      id="home-theme-toggle"
      aria-label="Toggle light/dark theme"
      type="button"
    >
      {/* Sun icon — shown in dark mode */}
      <svg class="home-theme-icon home-theme-icon--light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4"/>
        <path d="M12 2v2m0 16v2M4.93 4.93l1.41 1.41m11.32 11.32 1.41 1.41M2 12h2m16 0h2M4.93 19.07l1.41-1.41M18.36 5.64l1.41-1.41"/>
      </svg>
      {/* Moon icon — shown in light mode */}
      <svg class="home-theme-icon home-theme-icon--dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
      </svg>
    </button>
  </div>
</header>

<script>
  const toggle = document.getElementById('home-theme-toggle');
  if (toggle) {
    const apply = (theme: string) => {
      document.documentElement.dataset.theme = theme;
      localStorage.setItem('starlight-theme', theme);
    };
    toggle.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme;
      apply(current === 'dark' ? 'light' : 'dark');
    });
  }
</script>

<style>
  .home-header {
    position: sticky;
    top: 0;
    z-index: 100;
    width: 100%;
    height: 3.5rem;
    border-bottom: 1px solid var(--e2e-border);
    background: var(--sl-color-bg-nav);
    backdrop-filter: blur(12px);
  }

  .home-header__inner {
    display: flex;
    align-items: center;
    gap: 1rem;
    height: 100%;
    max-width: 90rem;
    margin: 0 auto;
    padding-inline: var(--sl-nav-pad-x, 1rem);
  }

  .home-header__title {
    font-size: 1rem;
    font-weight: 760;
    color: var(--e2e-text);
    text-decoration: none;
    letter-spacing: 0;
    white-space: nowrap;
    flex-shrink: 0;
  }

  .home-header__title:hover {
    color: var(--e2e-accent);
  }

  .home-header__products {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    border: 1px solid var(--e2e-border);
    border-radius: var(--e2e-radius);
    padding: 0.18rem;
    background: var(--e2e-bg-soft);
    margin-left: auto;
  }

  .home-header__product-link {
    display: inline-flex;
    align-items: center;
    min-height: 1.9rem;
    border-radius: 6px;
    padding: 0.3rem 0.7rem;
    color: var(--e2e-text-soft);
    font-size: 0.83rem;
    font-weight: 680;
    text-decoration: none;
    white-space: nowrap;
    transition: background 0.1s, color 0.1s;
  }

  .home-header__product-link:hover {
    background: var(--e2e-surface);
    color: var(--e2e-text);
  }

  .home-header__theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--e2e-border);
    border-radius: 6px;
    background: transparent;
    color: var(--e2e-text-soft);
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.1s, color 0.1s, border-color 0.1s;
  }

  .home-header__theme-toggle:hover {
    background: var(--e2e-bg-soft);
    color: var(--e2e-text);
    border-color: var(--e2e-border-strong);
  }

  .home-theme-icon {
    width: 1rem;
    height: 1rem;
  }

  /* Show sun in dark mode, moon in light mode */
  :root[data-theme='dark']  .home-theme-icon--dark  { display: none; }
  :root[data-theme='light'] .home-theme-icon--light { display: none; }
  :root[data-theme='dark']  .home-theme-icon--light { display: block; }
  :root[data-theme='light'] .home-theme-icon--dark  { display: block; }
</style>
