  api: 'M8 8 4 12l4 4m8-8 4 4-4 4M14 5l-4 14',
  billing:
    'M6 3h12v18l-2-1-2 1-2-1-2 1-2-1-2 1V3Zm3 5h6M9 12h6M9 16h4',
  compute:
    'M5 7a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V7Zm4 2h6v6H9V9Zm-6 1h2m14 0h2M3 14h2m14 0h2M10 3v2m4-2v2m-4 14v2m4-2v2',
  docs:
